rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // RM.STAR Settings & Customization rules
    // Allow public read so visitors see current logo & active promos
    // Allow write to settings document
    match /settings/{docId} {
      allow read, write: if true;
    }
    match /settings/{docId}/{allSubcollections=**} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
