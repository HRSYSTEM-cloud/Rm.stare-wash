rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // RM.STAR Settings & Customization rules
    // Allow public read so visitors see current logo & active promos
    // Allow write to settings document
    match /settings/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Default deny for any other document paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
